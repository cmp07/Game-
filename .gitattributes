# Optional Git LFS patterns for CJK/Latin faces (binaries remain gitignored until
# the team removes the matching .gitignore lines and runs `git lfs track`).
# See game/echo_lattice/fonts/cjk/README.md and tools/fonts/fetch_noto_sans_sc.py.
game/echo_lattice/fonts/cjk/*.otf filter=lfs diff=lfs merge=lfs -text
game/echo_lattice/fonts/cjk/*.ttf filter=lfs diff=lfs merge=lfs -text
game/echo_lattice/fonts/cjk/*.ttc filter=lfs diff=lfs merge=lfs -text
game/echo_lattice/fonts/cjk/*.otc filter=lfs diff=lfs merge=lfs -text
game/echo_lattice/fonts/latin/*.otf filter=lfs diff=lfs merge=lfs -text
game/echo_lattice/fonts/latin/*.ttf filter=lfs diff=lfs merge=lfs -text
