; Engine configuration file — The Weaver W1 prototype (loop + juice).
; Separate SKU from Echo Lattice; do not overwrite game/echo_lattice/.
; Juice feel demo scene: res://scenes/demo_field.tscn (open manually or swap run/main_scene).

config_version=5

[application]

config/name="The Weaver"
config/description="Recover Fragments, stitch Threads, seat Structures across a frayed gap. Workshop craft — not purple void."
run/main_scene="res://scenes/void_speak.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
config/version="0.1.0-proto"
boot_splash/bg_color=Color(0.019608, 0.023529, 0.039216, 1)
boot_splash/show_image=false

[autoload]

Loom="*res://scripts/loom/loom_state.gd"
WeaverPalette="*res://scripts/juice/weaver_palette.gd"
WeaverJuice="*res://scripts/juice/weaver_juice.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

