  "stars": {
    "metric": "moves_vs_bfs_par",
    "formula": "stars = 1 + (moves <= ceil(bfs_par * three_star_mult * act_mult * mode_slack)) + (moves <= ceil(bfs_par * two_star_mult * act_mult * mode_slack))",
    "bfs_par_padding": 2,
    "thresholds": {
      "three_star_mult": 1.15,
      "two_star_mult": 1.55,
      "one_star_mult": null
    },
    "notes": {
      "one_star": "Any legal clear awards 1★. Never gate progression on ★.",
      "two_star": "moves <= ceil((bfs_len + padding) * two_star_mult * act.star_par_multiplier * mode.star_slack)",
      "three_star": "moves <= ceil((bfs_len + padding) * three_star_mult * act.star_par_multiplier * mode.star_slack)"
    },
    "no_death_bonus": false,
    "habit_variety_bonus_star": false,
