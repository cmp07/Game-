; Godot 4 project configuration for Echo Lattice.
;
; Format is INI-like. Prefer editing via the Godot editor for most values.
; Free-form comments are kept minimal so `git diff` on editor-driven changes
; stays clean.

config_version=5

[application]

config/name="Echo Lattice"
config/description="A tense first-person vignette where the world you walk through is a lattice of your own habits, played back at you."
config/tags=PackedStringArray("first-person", "tension", "vignette", "single-player", "windows")
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.03, 0.03, 0.04, 1)

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
GameState="*res://scripts/autoload/game_state.gd"
HabitTracker="*res://scripts/autoload/habit_tracker.gd"
AudioBus="*res://scripts/autoload/audio_bus.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input]

move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"echo":false,"script":null)
]
}
move_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":83,"key_label":0,"unicode":0,"echo":false,"script":null)
]
}
move_left={
