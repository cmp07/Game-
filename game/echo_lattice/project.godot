; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Echo Lattice"
config/description="A labyrinth that rebuilds from your last thirty moves. Escape by rewriting your own habits."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"
config/version="0.2.0"
boot_splash/show_image=false

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Palette="*res://scripts/palette.gd"
ArtKit="*res://scripts/art_kit.gd"
GameState="*res://scripts/game_state.gd"
ChamberBook="*res://scripts/chamber_book.gd"
SaveManager="*res://scripts/save_manager.gd"
SettingsStore="*res://scripts/a11y/settings_store.gd"
AccessibilityService="*res://scripts/a11y/accessibility_service.gd"
ActionRemap="*res://scripts/a11y/action_remap.gd"
Juice="*res://scripts/juice.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
AdaptiveMusic="*res://scripts/audio/adaptive_music.gd"
SilenceDirector="*res://scripts/audio/silence_director.gd"
PaAnnouncer="*res://scripts/audio/pa_announcer.gd"
AudioDirector="*res://scripts/audio/audio_director.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=560
window/size/window_width_override=1152
window/size/window_height_override=672
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

