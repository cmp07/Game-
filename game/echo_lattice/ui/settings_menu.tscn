[node name="ShakeRow" type="HBoxContainer" parent="Panel/Margin/VBox/Scroll/Content"]
layout_mode = 2

[node name="ShakeIntensityLabel" type="Label" parent="Panel/Margin/VBox/Scroll/Content/ShakeRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Shake intensity"

[node name="ShakeIntensitySlider" type="HSlider" parent="Panel/Margin/VBox/Scroll/Content/ShakeRow"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(220, 0)
min_value = 0.0
max_value = 1.0
step = 0.05
value = 1.0

[node name="SubtitlesCheck" type="CheckButton" parent="Panel/Margin/VBox/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
