theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.545, 0.608, 0.702, 1)

[node name="TimerText" type="Label" parent="TopBar/H/TimerCol"]
unique_name_in_owner = true
text = "00:00"
horizontal_alignment = 2
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(0.663, 0.522, 1, 1)

; ------- LEFT RAIL (Habit Meter) -------
[node name="LeftRail" type="MarginContainer" parent="."]
