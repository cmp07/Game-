// SteamPipe app build script for Echo Lattice (Windows + Linux).
// Replace YOUR_APP_ID / YOUR_DEPOT_ID / YOUR_DEPOT_ID_LINUX after Steamworks app creation.
// Docs: docs/RELEASE/STEAMWORKS.md · docs/RELEASE/APPID_PLACEHOLDER_GATES.md
//
// Example:
//   steamcmd +login <user> +run_app_build <abs-path>/steam/echo_lattice/app_build.vdf +quit

"AppBuild"
{
	"AppID" "YOUR_APP_ID"
	"Desc" "Echo Lattice Windows + Linux build"
	"BuildOutput" "..\\..\\..\\dist\\echo_lattice\\steam_build_output"
	"ContentRoot" ""
	"SetLive" ""

	"Depots"
	{
		"YOUR_DEPOT_ID" "depot_windows.vdf"
		"YOUR_DEPOT_ID_LINUX" "depot_linux.vdf"
	}
}
