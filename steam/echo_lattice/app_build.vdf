// SteamPipe app build script for Echo Lattice (Windows-first).
// Replace YOUR_APP_ID / YOUR_DEPOT_ID after Steamworks app creation.
// Docs: docs/RELEASE/STEAMWORKS.md
//
// Example:
//   steamcmd +login <user> +run_app_build <abs-path>/steam/echo_lattice/app_build.vdf +quit

"AppBuild"
{
	"AppID" "YOUR_APP_ID"
	"Desc" "Echo Lattice Windows build"
	"BuildOutput" "..\\..\\..\\dist\\echo_lattice\\steam_build_output"
	"ContentRoot" ""
	"SetLive" ""

	"Depots"
	{
		"YOUR_DEPOT_ID" "depot_windows.vdf"
	}
}
