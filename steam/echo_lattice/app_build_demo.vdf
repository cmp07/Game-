// SteamPipe app build stub for Echo Lattice Demo (separate Demo AppID).
// Replace YOUR_DEMO_APP_ID / YOUR_DEMO_DEPOT_ID after Partner creates the demo app.
// Docs: docs/RELEASE/DEMO_SPEC.md · docs/RELEASE/APPID_PLACEHOLDER_GATES.md
//
// Example:
//   steamcmd +login <user> +run_app_build <abs-path>/steam/echo_lattice/app_build_demo.vdf +quit

"AppBuild"
{
	"AppID" "YOUR_DEMO_APP_ID"
	"Desc" "Echo Lattice Demo Windows build"
	"BuildOutput" "../../../dist/echo_lattice/steam_build_output_demo"
	"ContentRoot" ""
	"SetLive" ""

	"Depots"
	{
		"YOUR_DEMO_DEPOT_ID" "depot_windows_demo.vdf"
	}
}
