# Godot 4
.godot/
*.translation

# Local export overrides (git-ignore per-user)
.export_config.cfg
*.exe
*.pck
*.zip
*.apk
*.aab
*.dmg
*.app
*.x86_64
*.x86_32
*.arm64
*.wasm
*.html

# Import cache: keep committed .import sidecars for shared assets; ignore local import DB if any
# *.import  # usually commit these so teammates get same import settings

# Mono / C# (if used later)
.mono/
data_*/
mono_crash.*.json

# OS junk
Thumbs.db
Desktop.ini
.DS_Store
ehthumbs.db
$RECYCLE.BIN/

# Editors / IDE
.vs/
.vscode/
*.suo
*.user
*.userprefs
*.swp
*~

# Logs / temp
*.log
*.tmp
*.temp
.import/

# Godot 4 imports & editor artifacts
game/**/.godot/
# Keep global class cache so headless CI / selftest can resolve class_name without an editor pass.
!game/echo_lattice/.godot/
game/echo_lattice/.godot/*
!game/echo_lattice/.godot/global_script_class_cache.cfg
game/**/.import/
game/**/builds/

__pycache__/
*.py[cod]

# Large CJK font binaries — vendor locally per fonts/README.md; keep OFL + .gitkeep
game/echo_lattice/fonts/cjk/*.otf
game/echo_lattice/fonts/cjk/*.ttf
game/echo_lattice/fonts/cjk/*.ttc
game/echo_lattice/fonts/cjk/*.otc
game/echo_lattice/fonts/latin/*.otf
game/echo_lattice/fonts/latin/*.ttf
